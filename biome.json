{
	"$schema": "./biome-config/configuration_schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": ["src/**/*.ts", "tests/**/*.ts", "*.ts"],
		"ignoreUnknown": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"suspicious": { "noExplicitAny": "off" },
			"style": { "noNonNullAssertion": "off" }
		}
	},
	"javascript": { "formatter": { "quoteStyle": "double", "trailingCommas": "all" } }
}
